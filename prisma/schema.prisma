// SQLite locally. Provider is the only thing that has to change to move to
// Postgres: `sqlite` -> `postgresql` and drop `previewFeatures`-free defaults
// (the models below already avoid SQLite-specific features except `realtime`).
generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "windows"]
}

// Cloudflare Workers build of the same schema. `runtime = "cloudflare"` emits a
// client that loads the query engine as a WebAssembly module
// (`query_engine_bg.wasm?module`) instead of a native engine binary, which is
// what workerd can run. Local dev, tests and the CLI scripts keep using the
// Node.js client generated by `prisma-client-js` above.
generator cloudflare {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
  runtime  = "cloudflare"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Question {
  id        Int      @id @default(autoincrement())
  sortOrder Int      @unique @map("sort_order")
  text      String
  createdAt DateTime @default(now()) @map("created_at")
  options   Option[]
  answers   AttemptAnswer[]

  @@map("questions")
}

model Option {
  id         Int      @id @default(autoincrement())
  questionId Int      @map("question_id")
  sortOrder  Int      @map("sort_order")
  text       String
  correct    Boolean  @default(false)

  question Question        @relation(fields: [questionId], references: [id], onDelete: Cascade)
  answers  AttemptAnswer[]

  @@unique([questionId, sortOrder])
  @@index([questionId])
  @@map("options")
}

model Attempt {
  id           Int             @id @default(autoincrement())
  firstName    String          @map("first_name")
  lastName     String          @map("last_name")
  staticId     String          @map("static_id")
  browserId    String          @map("browser_id")
  score        Int
  total        Int
  percentage   Int
  createdAt    DateTime        @default(now()) @map("created_at")
  answers      AttemptAnswer[]
  submittedAt  DateTime        @default(now()) @map("submitted_at")

  @@index([createdAt])
  @@index([lastName, firstName])
  @@index([staticId, browserId, submittedAt])
  @@map("attempts")
}

// Admin-initiated cooldown lifts. A reset is keyed by static ID and only
// affects attempts submitted before it, so history stays intact.
model CooldownReset {
  id        Int      @id @default(autoincrement())
  staticId  String   @map("static_id")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([staticId, createdAt])
  @@map("cooldown_resets")
}

// Audit trail: which option each participant picked, without trusting the client.
model AttemptAnswer {
  id         Int     @id @default(autoincrement())
  attemptId  Int     @map("attempt_id")
  questionId Int     @map("question_id")
  optionId   Int?    @map("option_id")
  isCorrect  Boolean @map("is_correct")

  attempt  Attempt   @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question Question  @relation(fields: [questionId], references: [id], onDelete: Cascade)
  option   Option?   @relation(fields: [optionId], references: [id], onDelete: SetNull)

  @@unique([attemptId, questionId])
  @@index([attemptId])
  @@map("attempt_answers")
}

